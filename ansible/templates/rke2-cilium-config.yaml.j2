# GENERATED BY ANSIBLE - do not edit on the node.
# Must exist before rke2-server first starts, so that Cilium is installed
# with kube-proxy replacement rather than being reconfigured afterwards.
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: rke2-cilium
  namespace: kube-system
spec:
  valuesContent: |-
    kubeProxyReplacement: true
    # RKE2 runs a per-node load balancer on 127.0.0.1:6443, so Cilium can
    # reach the API server before cluster networking exists. This is why the
    # kube-vip VIP is not needed here.
    k8sServiceHost: "localhost"
    k8sServicePort: "6443"
    hubble:
      enabled: true
      relay:
        enabled: true
{% if rke2_taint_control_plane %}
    # RKE2's packaged Cilium chart tolerates every taint EXCEPT
    # CriticalAddonsOnly - the one RKE2's own hardening guidance tells you to
    # put on control planes. With tainted control planes and no workers yet,
    # the operator cannot schedule, so it never registers its CRDs, so every
    # cilium-agent blocks forever and the cluster has no CNI.
    #
    # Helm replaces a tolerations list rather than merging it, so the chart's
    # original seven are repeated here verbatim.
    operator:
      tolerations:
        - key: CriticalAddonsOnly
          operator: Exists
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
        - key: node-role.kubernetes.io/etcd
          operator: Exists
        - key: node-role.kubernetes.io/master
          operator: Exists
        - key: node.cilium.io/agent-not-ready
          operator: Exists
        - key: node.cloudprovider.kubernetes.io/uninitialized
          operator: Exists
        - key: node.kubernetes.io/not-ready
          operator: Exists
        - key: node.kubernetes.io/unreachable
          operator: Exists
          effect: NoExecute
          tolerationSeconds: 300
{% endif %}
