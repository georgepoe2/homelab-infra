# GENERATED BY ANSIBLE - do not edit on the node.
# Agents carry no cluster configuration: CIDRs, CNI and disabled components
# are decided by the servers and inherited on join.
token: "{{ rke2_token }}"
server: "https://{{ rke2_vip }}:9345"
node-ip: "{{ ansible_host }}"

# Same CIS profile as the servers. Agents need the hardened sysctls but not
# the etcd user, since they run no etcd.
profile: "{{ rke2_profile }}"
