# GENERATED BY ANSIBLE - do not edit on the node.
# Several of these values are written into certificates and cluster state at
# first boot and cannot be changed afterwards without a rebuild.

token: "{{ rke2_token }}"

{% if inventory_hostname != rke2_bootstrap_host %}
# Join the existing cluster through the kube-vip VIP, not a specific node.
server: "https://{{ rke2_vip }}:9345"
{% endif %}

node-ip: "{{ ansible_host }}"

tls-san:
{% for san in rke2_tls_san %}
  - "{{ san }}"
{% endfor %}

cluster-cidr: "{{ rke2_cluster_cidr }}"
service-cidr: "{{ rke2_service_cidr }}"

# ADR-002. Cilium replaces kube-proxy entirely; see the rke2-cilium
# HelmChartConfig in the manifests directory for the values that enable it.
cni: cilium
disable-kube-proxy: true

# CIS benchmark hardening. Requires the etcd user and CIS sysctls on the host.
profile: "{{ rke2_profile }}"

# Flux owns these after Phase 7. RKE2's deploy controller reconciles whatever
# it ships forever, so two controllers would fight indefinitely.
# RKE2 1.36 ships Traefik as its bundled ingress, not ingress-nginx. Verified
# by listing /var/lib/rancher/rke2/server/manifests on the bootstrap node -
# disabling the wrong one leaves the real controller running for Flux to fight.
disable:
  - rke2-traefik
  - rke2-traefik-crd
  - rke2-ingress-nginx
  - rke2-servicelb

{% if rke2_taint_control_plane %}
node-taint:
  - "CriticalAddonsOnly=true:NoExecute"
{% endif %}

# etcd snapshots straight to SeaweedFS on the NAS.
etcd-snapshot-schedule-cron: "{{ rke2_etcd_snapshot_cron }}"
etcd-snapshot-retention: {{ rke2_etcd_snapshot_retention }}
etcd-s3: true
etcd-s3-endpoint: "{{ rke2_etcd_s3_endpoint }}"
etcd-s3-bucket: "{{ rke2_etcd_s3_bucket }}"
etcd-s3-region: "{{ rke2_etcd_s3_region }}"
etcd-s3-insecure: true
# Not optional: the default 'auto' has been observed not to fall back to
# path-style against self-hosted S3, and the failure mode is silent - no
# error, no log, no uploads.
etcd-s3-bucket-lookup-type: path
etcd-s3-access-key: "{{ rke2_etcd_s3_access_key }}"
etcd-s3-secret-key: "{{ rke2_etcd_s3_secret_key }}"
etcd-s3-retention: {{ rke2_etcd_snapshot_retention }}

write-kubeconfig-mode: "0600"
